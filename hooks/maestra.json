{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-start 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-start 2>/dev/null || sh \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/activar.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-prompt 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-prompt 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-read 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-read 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-agent 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-agent 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-shell 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-shell 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-agent-fin 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-agent-fin 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-editado 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/skills/s0k1x-maestra/scripts/memo.py\" hook-editado 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
